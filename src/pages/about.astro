---

import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import Markdown from "@components/content/Markdown.astro";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");
const aboutContent = aboutPost ? await render(aboutPost) : null;
const AboutContent = aboutContent?.Content;
const hasAboutBody = Boolean(aboutPost?.body?.trim());
const markdownStylesheetAssets = aboutContent
	? await getMarkdownStylesheetAssets(
			aboutContent.remarkPluginFrontmatter.markdownSyntaxes,
		)
	: [];
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)} page="about">
    {!hasAboutBody && <PageHeader title={i18n(I18nKey.about)} />}
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <Card color="var(--card-bg)" radius="l" class="z-10 px-9 py-6 relative w-full">
            <Markdown class="mt-2">
                {AboutContent && <AboutContent />}
            </Markdown>
        </Card>
    </div>
</MainGridLayout>
